## duration parse
R4 | duration "1h" => 1h | seconds 3600 | 1 hour | exact
R4 | duration "90m" => 90m | seconds 5400 | 1 hour, 30 minutes | exact
R4 | duration "1h 30m" => 1h 30m | seconds 5400 | 1 hour, 30 minutes | exact
R3,R4 | duration "1h30m" => 1h30m | seconds 5400 | 1 hour, 30 minutes | exact
R4 | duration "1h, 30m" => 1h, 30m | seconds 5400 | 1 hour, 30 minutes | exact
R3,R4 | duration "1h,30m" => 1h,30m | seconds 5400 | 1 hour, 30 minutes | exact
R4 | duration "-1h 30m" => -1h 30m | seconds -5400 | -1 hour, 30 minutes | exact
R3,R4 | duration "+1h" => +1h | seconds 3600 | 1 hour | exact
R3,R4 | duration ".5h" => .5h | seconds 1800 | 30 minutes | exact
R4 | duration "1.5h" => 1.5h | seconds 5400 | 1 hour, 30 minutes | exact
R3,R4 | duration "0.5h 15m" => 0.5h 15m | seconds 2700 | 45 minutes | exact
R3,R4 | duration "1e3s" => 1e3s | seconds 1000 | 16 minutes, 40 seconds | exact
R3,R4 | duration "1E-2s" => 1E-2s | seconds 0.01 | 10 milliseconds | exact
R3,R4 | duration "1h +30m" => 1h +30m | seconds 5400 | 1 hour, 30 minutes | exact
R3,R4 | duration "1H" => 1H | seconds 3600 | 1 hour | exact
R4 | duration "1 h" => 1 h | seconds 3600 | 1 hour | exact
R3,R4 | duration "1 H" => 1 H | seconds 3600 | 1 hour | exact
R3,R4 | duration "4 yrs, 6 wks" => 4 yrs, 6 wks | seconds 129772800 | 4 years, 1 month, 1 week, 5 days | calendar
R4 | duration "2 weeks" => 2 weeks | seconds 1209600 | 2 weeks | calendar
R4 | duration "3 days" => 3 days | seconds 259200 | 3 days | calendar
R3,R4 | duration "1d 1mo" => 1d 1mo | seconds 2678400 | 1 month, 1 day | calendar
R3,R4 | duration "1mo 1d" => 1mo 1d | seconds 2678400 | 1 month, 1 day | calendar
R3,R4 | duration "12h 12h" => 12h 12h | seconds 86400 | 1 day | exact
R4 | duration "1y 2mo 3w 4d 5h 6m 7s 8ms" => 1y 2mo 3w 4d 5h 6m 7s 8ms | seconds 38898367.008 | 1 year, 2 months, 3 weeks, 4 days, 5 hours, 6 minutes, 7 seconds, 8 milliseconds | calendar
R4 | duration "0s" => 0s | seconds 0 | 0 seconds | exact
R4 | duration "-0m" => -0m | seconds 0 | 0 seconds | exact
R4 | duration "1ms" => 1ms | seconds 0.001 | 1 millisecond | exact
R4 | duration "1.5ms" => 1.5ms | seconds 0.0015 | 2 milliseconds | exact
R5 | duration "0.0005s" => 0.0005s | seconds 0.0005 | 1 millisecond | exact
R3,R4 | duration "1.5d" => 1.5d | seconds 129600 | 1 day, 12 hours | calendar
R3,R4 | duration "1.5mo" => 1.5mo | seconds 3888000 | 1 month, 2 weeks, 1 day | calendar
R5 | duration "7304484d" => 7304484d | seconds 631107417600 | 20012 years, 3 months, 2 weeks | calendar
R5 | duration "7304485d" => 7304485d | seconds 631107504000 | 20012 years, 3 months, 2 weeks, 1 day | calendar
R5 | duration "9e15s" => 9e15s | seconds 9e15 | 285388127 years, 10 months, 1 week, 4 days, 16 hours | exact
R5 | duration "1e400s" => Err(NumberOverflow)
R5 | duration "100000000y" => 100000000y | seconds 3.1536e15 | 100000000 years | calendar
R3,R4 | duration "3 Hours" => 3 Hours | seconds 10800 | 3 hours | exact
R3,R4 | duration "2 MINUTES" => 2 MINUTES | seconds 120 | 2 minutes | exact
R4 | duration "10 secs" => 10 secs | seconds 10 | 10 seconds | exact
- | duration "" => Err(Empty)
- | duration "  " => Err(Empty)
- | duration "h" => Err(MissingNumber)
- | duration "1" => Err(MissingUnit)
- | duration "1x" => Err(UnknownUnit)
- | duration "1h30" => Err(MissingUnit)
- | duration "1h -30m" => Err(MisplacedSign)
- | duration "1 hh" => Err(UnknownUnit)
- | duration "--1h" => Err(MisplacedSign)
- | duration "1h--30m" => Err(MisplacedSign)
- | duration "1.2.3h" => Err(MissingUnit)
- | duration "e3s" => Err(MissingNumber)
- | duration "NaN s" => Err(MissingNumber)
R3 | duration "infh" => Err(MissingNumber)
- | duration "1,h" => Err(MissingUnit)
- | duration ",1h" => ,1h | seconds 3600 | 1 hour | exact
- | duration "1h," => 1h, | seconds 3600 | 1 hour | exact
- | duration "1 h 30" => Err(MissingUnit)
R3 | duration "P1D" => Err(MissingNumber)
R3 | duration "PT90M" => Err(MissingNumber)
R3 | duration "1µs" => Err(MissingUnit)
R3 | duration "1us" => Err(UnknownUnit)
R3 | duration "1ns" => Err(UnknownUnit)

## duration prefix
R3 | prefix "1h rest" => 1h | seconds 3600 | 1 hour | exact @2
R3 | prefix "1h, 2m" => 1h | seconds 3600 | 1 hour | exact @2
R3 | prefix "1h,2m" => 1h | seconds 3600 | 1 hour | exact @2
R3 | prefix "30m, next" => 30m | seconds 1800 | 30 minutes | exact @3
R3 | prefix "1h 30m)" => 1h 30m | seconds 5400 | 1 hour, 30 minutes | exact @6
R3 | prefix "1h x" => 1h | seconds 3600 | 1 hour | exact @2
R3 | prefix "x1h" => None
R3 | prefix "-1h" => -1h | seconds -3600 | -1 hour | exact @3
R3 | prefix "1h -2m" => None
R3 | prefix "2d\n3" => None
R3 | prefix "- 1h" => None
R3 | prefix "1h30m" => 1h30m | seconds 5400 | 1 hour, 30 minutes | exact @5
R3 | prefix "1.5d x" => 1.5d | seconds 129600 | 1 day, 12 hours | calendar @4
R3 | prefix "1e3s,x" => 1e3s | seconds 1000 | 16 minutes, 40 seconds | exact @4
R3 | prefix "1h+2m" => 1h+2m | seconds 3720 | 1 hour, 2 minutes | exact @5
R3 | prefix "1h 2" => None
R3 | prefix "5" => None
R3 | prefix "" => None

## duration operations
R4,R16 | 23h + 1h => 1d | seconds 86400 | 1 day | exact
R4,R16 | 23h - 1h => 22h | seconds 79200 | 22 hours | exact
R4,R16 | 1d + 1h => 1d 1h | seconds 90000 | 1 day, 1 hour | calendar
R4,R16 | 1d - 1h => 23h | seconds 82800 | 23 hours | calendar
R4,R16 | 1h 30m + 30m => 2h | seconds 7200 | 2 hours | exact
R4,R16 | 1h 30m - 30m => 1h | seconds 3600 | 1 hour | exact
R4,R16 | 1mo + 1d => 4w 3d | seconds 2678400 | 1 month, 1 day | calendar
R4,R16 | 1mo - 1d => 4w 1d | seconds 2505600 | 4 weeks, 1 day | calendar
R4,R16 | 2d + 1d => 3d | seconds 259200 | 3 days | calendar
R4,R16 | 2d - 1d => 1d | seconds 86400 | 1 day | calendar
R4,R16 | 1d + 2d => 3d | seconds 259200 | 3 days | calendar
R4,R16 | 1d - 2d => -1d | seconds -86400 | -1 day | calendar
R4,R16 | 1h + 1h => 2h | seconds 7200 | 2 hours | exact
R4,R16 | 1h - 1h => 0s | seconds 0 | 0 seconds | exact
R4,R16 | 1w + 1d => 1w 1d | seconds 691200 | 1 week, 1 day | calendar
R4,R16 | 1w - 1d => 6d | seconds 518400 | 6 days | calendar
R4,R16 | 90m + 1h 30m => 3h | seconds 10800 | 3 hours | exact
R4,R16 | 90m - 1h 30m => 0s | seconds 0 | 0 seconds | exact
R4,R16 | 1y + 1mo => 56w 3d | seconds 34128000 | 1 year, 1 month | calendar
R4,R16 | 1y - 1mo => 47w 6d | seconds 28944000 | 11 months, 5 days | calendar
R15 | 1h * 2 => 2h | seconds 7200 | 2 hours | exact
R15 | 1h * 0.5 => 30m | seconds 1800 | 30 minutes | exact
R15 | 1h * -1 => -1h | seconds -3600 | -1 hour | exact
R15 | 1h * 1.5 => 1h 30m | seconds 5400 | 1 hour, 30 minutes | exact
R15 | 1h * 0 => 0s | seconds 0 | 0 seconds | exact
R15 | 1h *  => infs | seconds inf | inf seconds | exact
R15 | 1h * NaN => NaNs | seconds NaN | 0 seconds | exact
R4 | -(1h) => -1h | seconds -3600 | -1 hour | exact
R15 | 1d * 2 => 2d | seconds 172800 | 2 days | calendar
R15 | 1d * 0.5 => 12h | seconds 43200 | 12 hours | calendar
R15 | 1d * -1 => -1d | seconds -86400 | -1 day | calendar
R15 | 1d * 1.5 => 1d 12h | seconds 129600 | 1 day, 12 hours | calendar
R15 | 1d * 0 => 0s | seconds 0 | 0 seconds | calendar
R15 | 1d *  => infs | seconds inf | inf seconds | calendar
R15 | 1d * NaN => NaNs | seconds NaN | 0 seconds | calendar
R4 | -(1d) => -1d | seconds -86400 | -1 day | calendar
R15 | 1mo * 2 => 8w 4d | seconds 5184000 | 2 months | calendar
R15 | 1mo * 0.5 => 2w 1d | seconds 1296000 | 2 weeks, 1 day | calendar
R15 | 1mo * -1 => -4w 2d | seconds -2592000 | -1 month | calendar
R15 | 1mo * 1.5 => 6w 3d | seconds 3888000 | 1 month, 2 weeks, 1 day | calendar
R15 | 1mo * 0 => 0s | seconds 0 | 0 seconds | calendar
R15 | 1mo *  => infs | seconds inf | inf seconds | calendar
R15 | 1mo * NaN => NaNs | seconds NaN | 0 seconds | calendar
R4 | -(1mo) => -4w 2d | seconds -2592000 | -1 month | calendar
R15 | 1h 30m * 2 => 3h | seconds 10800 | 3 hours | exact
R15 | 1h 30m * 0.5 => 45m | seconds 2700 | 45 minutes | exact
R15 | 1h 30m * -1 => -1h 30m | seconds -5400 | -1 hour, 30 minutes | exact
R15 | 1h 30m * 1.5 => 2h 15m | seconds 8100 | 2 hours, 15 minutes | exact
R15 | 1h 30m * 0 => 0s | seconds 0 | 0 seconds | exact
R15 | 1h 30m *  => infs | seconds inf | inf seconds | exact
R15 | 1h 30m * NaN => NaNs | seconds NaN | 0 seconds | exact
R4 | -(1h 30m) => -1h 30m | seconds -5400 | -1 hour, 30 minutes | exact
R15 | -2d * 2 => -4d | seconds -345600 | -4 days | calendar
R15 | -2d * 0.5 => -1d | seconds -86400 | -1 day | calendar
R15 | -2d * -1 => 2d | seconds 172800 | 2 days | calendar
R15 | -2d * 1.5 => -3d | seconds -259200 | -3 days | calendar
R15 | -2d * 0 => 0s | seconds 0 | 0 seconds | calendar
R15 | -2d *  => -infs | seconds -inf | -inf seconds | calendar
R15 | -2d * NaN => NaNs | seconds NaN | 0 seconds | calendar
R4 | -(-2d) => 2d | seconds 172800 | 2 days | calendar
R15 | 0s * 2 => 0s | seconds 0 | 0 seconds | exact
R15 | 0s * 0.5 => 0s | seconds 0 | 0 seconds | exact
R15 | 0s * -1 => 0s | seconds 0 | 0 seconds | exact
R15 | 0s * 1.5 => 0s | seconds 0 | 0 seconds | exact
R15 | 0s * 0 => 0s | seconds 0 | 0 seconds | exact
R15 | 0s *  => 0s | seconds 0 | 0 seconds | exact
R15 | 0s * NaN => NaNs | seconds NaN | 0 seconds | exact
R4 | -(0s) => 0s | seconds 0 | 0 seconds | exact
- | order 1h vs 60m => Equal eq=true
- | order 1d vs 24h => Equal eq=true
- | order 1mo vs 30d => Equal eq=true
- | order 1y vs 365d => Equal eq=true
- | order 1h vs 2h => Less eq=false
- | order 1w vs 7d => Equal eq=true
- | order 0s vs -0m => Equal eq=true

## duration serde
R4 | to json 1h 30m => "1h 30m"
R4 | to json 90m => "90m"
R4 | to json 4 yrs, 6 wks => "4 yrs, 6 wks"
R4 | to json -1d => "-1d"
R4 | to json 0s => "0s"
R4 | to json 1.5h => "1.5h"
R3 | from json "1h 30m" => 1h 30m | seconds 5400 | 1 hour, 30 minutes | exact
R3 | from json "90m" => 90m | seconds 5400 | 1 hour, 30 minutes | exact
R3 | from json "" => Err(Invalid)
R3 | from json "nope" => Err(Invalid)
R3 | from json 42 => Err(Invalid)
R3 | from json null => Err(Invalid)
R3 | from json "1d 1h" => 1d 1h | seconds 90000 | 1 day, 1 hour | calendar

## date value parse
- | date "2026-07-29" => 2026-07-29 "2026-07-29"
R6 | date "2026-1-1" => 2026-01-01 "2026-01-01"
