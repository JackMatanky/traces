- | date "2026-07" => 2026-07-01 "2026-07-01"
- | date "2026-07-29 " => 2026-07-29 "2026-07-29"
R14 | date "0000-01-01" => 0000-01-01 "0000-01-01"
R14 | date "9999-12-31" => 9999-12-31 "9999-12-31"
