- | date from json 7 => Err(Invalid)
- | date from json "2026-07-29T10:00:00Z" => Err(Invalid)

## date point parse
- | point "2026-07-29" => date 2026-07-29 (day)
- | point "2026-07" => date 2026-07-01 (month)
- | point "2026" => Err(UnknownShape)
- | point "2026-" => Err(InvalidValue)
- | point "26-07-29" => Err(YearNotFourDigits)
- | point "2026-1" => Err(InvalidValue)
- | point "2026-13" => Err(InvalidValue)
- | point "2026-00" => Err(InvalidValue)
- | point "2026-02-30" => Err(InvalidValue)
- | point "  2026-07-29  " => date 2026-07-29 (day)
- | point "20260729" => Err(UnknownShape)
- | point "" => Err(UnknownShape)
R6 | point "2026-1-1" => date 2026-01-01 (day)
- | point "202-07-29" => Err(UnknownShape)
- | point prefix "2026-07-29 rest" => date 2026-07-29 (day) @10
- | point prefix "2026-07 rest" => date 2026-07-01 (month) @7
- | point prefix "2026-07-29T10:00" => date 2026-07-29 (day) @10
R6 | point prefix "2026-1-1" => None
- | point prefix "2026-07-2" => None
- | point prefix "26-07-29" => None
- | point prefix "2026-07-" => None
- | point prefix "2026-07-29" => date 2026-07-29 (day) @10
- | point prefix "2026-07" => date 2026-07-01 (month) @7
- | point prefix "2026-13-01 x" => None
- | point prefix "2026-07-299" => date 2026-07-29 (day) @10
- | point prefix "x2026-07-29" => None
- | point prefix "" => None

