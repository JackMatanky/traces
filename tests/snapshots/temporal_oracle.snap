- | date "2026-00-10" => Err(InvalidValue)
- | date "2026-12-00" => Err(InvalidValue)
- | date "2026-12-32" => Err(InvalidValue)
- | date "2026-07-29x" => Err(InvalidValue)
- | date "2026-07-29T10:00" => Err(InvalidValue)
- | date "" => Err(YearNotFourDigits)
- | date "  2026-07-29  " => 2026-07-29 "2026-07-29"
- | date from json "2026-07-29" => 2026-07-29 "2026-07-29"
R6 | date from json "2026-1-1" => 2026-01-01 "2026-01-01"
- | date from json "2026-07" => 2026-07-01 "2026-07-01"
