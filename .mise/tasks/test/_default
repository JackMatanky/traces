#!/bin/bash
#MISE description="Canonical test run: lib/bin units (production), integration (test-utils), E2E (shipped binary), doctests (all-features)"
#MISE alias="t"
#MISE sources=["@group:rust"]
#MISE extends="gate:never-skip"
#USAGE flag "--docs" negate="--no-docs" default=#true {
#USAGE   help "Also run doctests after the three nextest phases"
#USAGE   long_help """
#USAGE   Enabled by default:
#USAGE   - library and binary unit/component tests on the production configuration
#USAGE   - integration phase on the test-utils feature
#USAGE   - E2E phase against the shipped feature-off binary
#USAGE   - doctests explicitly under --all-features (never default: test-support
#USAGE     doctests would silently drop; CI requires a nonzero doctest count)
#USAGE   Unfiltered nextest phases fail rather than silently running zero tests.
#USAGE   Pass --no-docs to skip the doctest phase.
#USAGE   """
#USAGE }
#USAGE arg "[args]" var=#true {
#USAGE   help "Filter arguments forwarded to every nextest phase"
#USAGE   long_help """
#USAGE   Examples:
#USAGE   - `mise run test -E 'test(index::refresh)'` - nextest filter expression
#USAGE   - `mise run test refresh` - name substring filter
#USAGE   - `mise run test --no-docs -E 'binary(e2e)'` - E2E suite only;
#USAGE     filtered runs skip empty phases and fail if no phase matches
#USAGE   """
#USAGE }

# shellcheck disable=SC2154  # usage_* are injected by mise
set -euo pipefail

declare -a phase_args=()
matched_phases=0

#######################################
# Expands variadic passthrough arguments into phase_args (shared by all
# three nextest phases).
# Globals:
#   usage_args
#   phase_args
# Arguments:
#   None
# Outputs:
#   None
# Returns:
#   0 on success.
#######################################
parse_passthrough_tokens() {
  # usage_args arrives shell-quoted (var=#true arg); eval expands it into
  # array elements.
  eval "phase_args+=(${usage_args:-})"
}

#######################################
# Runs one canonical phase, skipping empty filtered phases without hiding
# a filter that matches no tests in any phase.
# Globals:
#   phase_args
#   matched_phases
# Arguments:
#   Phase label (for the progress line), then the nextest arguments.
# Outputs:
#   Phase header and nextest output to STDOUT/STDERR.
# Returns:
#   Status of cargo nextest.
#######################################
run_phase() {
  local label="$1"
  shift
  echo "==> test phase: ${label}"
  if ((${#phase_args[@]} > 0)); then
    local matches
    matches="$(cargo nextest list -p traces --message-format oneline "$@")"
    if [[ -z "${matches}" ]]; then
      echo "==> no matching ${label} tests"
      return 0
    fi
    matched_phases=$((matched_phases + 1))
  fi
  cargo nextest run -p traces --no-tests fail "$@"
}

#######################################
# Coordinates the four canonical phases.
# Globals:
#   usage_docs
# Arguments:
#   CLI arguments vector.
# Outputs:
#   Phase headers and test output to STDOUT/STDERR.
# Returns:
#   Exit status of the first failing phase.
#######################################
main() {
  parse_passthrough_tokens

  # Unit/component: production configuration (no test-utils, no features).
  run_phase unit --no-default-features --lib --bin traces \
    "${phase_args[@]+"${phase_args[@]}"}"

  # Integration: the cross-module suite requires the test-utils feature.
  run_phase integration --features test-utils --test integration \
    "${phase_args[@]+"${phase_args[@]}"}"

  # E2E: black-box suite against the shipped configuration — the binary is
  # built without test-utils on purpose (tests spawn it).
  run_phase e2e --no-default-features --test e2e \
    "${phase_args[@]+"${phase_args[@]}"}"

  if ((${#phase_args[@]} > 0 && matched_phases == 0)); then
    echo "ERROR: filter matched no tests in any phase" >&2
    return 1
  fi

  # Doctests: explicitly --all-features, never the default configuration —
  # test-support doctests would silently drop (CI requires a nonzero count).
  if [[ "${usage_docs:-true}" == "true" ]]; then
    echo "==> test phase: docs (all-features)"
    mise run test:doc --feature all
  fi
}

main "$@"
