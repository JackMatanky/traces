#!/bin/bash
#MISE description="Run nextest tests (all targets and features by default)"
#MISE sources=["@group:rust"]
#MISE extends="gate:never-skip"
#USAGE flag "-m --mod <module>" {
#USAGE   help "Run tests for a specific module only"
#USAGE   long_help """
#USAGE   Scopes nextest to the named module using a filter expression. For example:
#USAGE   - `-m index` filters to tests under module `index`
#USAGE
#USAGE   Module filtering matches library test names; use -E with a binary()
#USAGE   selector to select an integration or E2E target.
#USAGE   For the feature-separated canonical suite, use mise run test.
#USAGE   """
#USAGE }
#USAGE // `complete "module"` completes the value after `-m`/`--mod`, not the flag name.
#USAGE complete "module" run="sed -nE 's/^(pub )?mod ([a-z_]+);$/\\2/p' src/lib.rs"
#USAGE flag "--feature <feature>" default="all" {
#USAGE   help "Cargo feature to activate (all, none, or a specific feature)"
#USAGE   long_help """
#USAGE   Selects Cargo feature set:
#USAGE   - `all`: passes `--all-features`
#USAGE   - `none`: production configuration (no feature flags — the crate has no
#USAGE     `default` feature, so the old `default` value was a hard cargo error)
#USAGE   - any other value passes `--features <feature>`
#USAGE   """
#USAGE }
#USAGE arg "[args]" var=#true {
#USAGE   help "Extra arguments forwarded to `cargo nextest run`"
#USAGE   long_help """
#USAGE   Examples:
#USAGE   - `mise run test:unit index::query` - run tests matching name substring
#USAGE   - `mise run test:unit --test integration` - run the integration binary
#USAGE   - `mise run test:unit --test e2e` - run the E2E binary
#USAGE   - `mise run test:unit -E 'test(/^index::/)'` - nextest filter DSL
#USAGE   """
#USAGE }

# shellcheck disable=SC2154  # usage_* are injected by mise
set -euo pipefail

declare -a unit_args=()

#######################################
# Maps feature selection flag to cargo nextest package and feature arguments.
# Globals:
#   usage_feature
#   unit_args
# Arguments:
#   None
# Outputs:
#   None
# Returns:
#   0 on success.
#######################################
resolve_package_feature_args() {
  if [[ "${usage_feature:-all}" == "all" ]]; then
    unit_args+=(-p traces --all-features)
  elif [[ "${usage_feature:-all}" == "none" ]]; then
    # Production configuration: the crate defines no `default` feature, so
    # no feature flags are passed (the old `--features default` value was a
    # hard cargo error).
    unit_args+=(-p traces --no-default-features)
  else
    unit_args+=(-p traces --features "${usage_feature}")
  fi
}

#######################################
# Formats module filter flag into nextest expression DSL filter.
# Globals:
#   usage_mod
#   unit_args
# Arguments:
#   None
# Outputs:
#   None
# Returns:
#   0 on success.
#######################################
resolve_module_filter() {
  if [[ -n "${usage_mod:-}" ]]; then
    unit_args+=(-E "test(/^${usage_mod}::/)")
  fi
}

#######################################
# Expands variadic passthrough arguments into unit_args.
# Globals:
#   usage_args
#   unit_args
# Arguments:
#   None
# Outputs:
#   None
# Returns:
#   0 on success.
#######################################
parse_passthrough_tokens() {
  # usage_args arrives shell-quoted (var=#true arg); eval expands it
  # into array elements.
  eval "unit_args+=(${usage_args:-})"
}

#######################################
# Assembles argument vector and executes cargo nextest run.
# Globals:
#   unit_args
# Arguments:
#   CLI arguments vector.
# Outputs:
#   Nextest run results to STDOUT/STDERR.
# Returns:
#   Status of cargo nextest.
#######################################
main() {
  resolve_package_feature_args
  resolve_module_filter
  parse_passthrough_tokens

  cargo nextest run "${unit_args[@]}"
}

main "$@"
